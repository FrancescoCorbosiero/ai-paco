---
import Base from '../layouts/Base.astro';
import ChatDemo from '../components/ChatDemo.astro';
import SectionHead from '../components/SectionHead.astro';
import PricingCards from '../components/PricingCards.astro';
import CtaBand from '../components/CtaBand.astro';
import Marquee from '../components/Marquee.astro';
import CommandDemo from '../components/CommandDemo.astro';
import SiteShowcase from '../components/SiteShowcase.astro';
import VoicesWall from '../components/VoicesWall.astro';
import WhatsAppCta from '../components/WhatsAppCta.astro';
import { SITE_TITLE, SITE_DESCRIPTION, EARLY_ACCESS_LABEL, ALPACODE_URL } from '../config';
import { t } from '../i18n/ui';

const steps = [
  {
    n: '01',
    t: 'Racconta la tua attività',
    d: 'Paco ti fa qualche domanda su WhatsApp: orari, servizi, qualche foto. Rispondi quando puoi, anche tra un cliente e l’altro. Il listino? Basta una foto di quello appeso in negozio.',
  },
  {
    n: '02',
    t: 'Paco crea il sito',
    d: 'Ti manda l’anteprima in chat. Vuoi cambiare qualcosa? Diglielo a parole — «metti prima le foto», «quel verde è troppo acceso» — finché non ti piace. Poi pubblica lui.',
  },
  {
    n: '03',
    t: 'Aggiorna scrivendo',
    d: '«Ad agosto chiudiamo due settimane.» «Pubblica l’offerta di settembre.» Dieci secondi in chat, ed è online. Il sito non resta mai indietro.',
  },
];

const features = [
  {
    t: 'Online in un paio di giorni',
    d: 'Dal primo messaggio al sito pubblicato: a te serve mezz’ora in tutto, spalmata come vuoi.',
  },
  {
    t: 'Aggiornamenti illimitati',
    d: 'Ogni modifica è un messaggio. Nessun costo a intervento, nessuna agenzia da rincorrere.',
  },
  {
    t: 'Offerte con la scadenza',
    d: '«Valida fino a fine mese»: quando scade, Paco la toglie da solo. Mai più promozioni fantasma.',
  },
  {
    t: 'Risposte a qualsiasi ora',
    d: 'Ai clienti che scrivono risponde Paco, anche alle 23:40 — solo con le informazioni del tuo sito.',
  },
  {
    t: 'Tu, quando conta',
    d: 'Richieste particolari, lamentele, trattative: Paco ti passa la conversazione con un riepilogo ordinato.',
  },
  {
    t: 'Il resoconto, senza grafici',
    d: 'Una volta a settimana, in chat: visite, conversazioni gestite, richieste passate a te. Numeri semplici.',
  },
];

const verticals = [
  {
    href: '/per-chi/ristoranti',
    label: 'Ristoranti e pizzerie',
    quote: '«Stasera niente fritti.» — Fatto: menù aggiornato e clienti avvisati.',
  },
  {
    href: '/per-chi/parrucchieri',
    label: 'Parrucchieri ed estetiste',
    quote: '«La piega è 20 adesso.» — Corretto sul listino ✔️',
  },
  {
    href: '/per-chi/artigiani',
    label: 'Artigiani',
    quote: 'Urgenza alle 21:50 → richiesta ordinata con zona e foto, non una chiamata persa.',
  },
  {
    href: '/per-chi/professionisti',
    label: 'Professionisti',
    quote: 'Richieste già qualificate. I pareri, quelli, restano tuoi.',
  },
];

const chips = [
  { emoji: '🍕', label: 'Pizzeria', fill: 'Ho una pizzeria: il menù cambia spesso e il sito è fermo da anni.' },
  { emoji: '✂️', label: 'Salone', fill: 'Ho un salone da parrucchiera, niente sito e le clienti scrivono a tutte le ore.' },
  { emoji: '🔧', label: 'Idraulico', fill: 'Sono idraulico: quando lavoro non posso rispondere e perdo chiamate.' },
  { emoji: '📐', label: 'Studio tecnico', fill: 'Ho uno studio tecnico e vorrei richieste già fatte bene, non «quanto costa?».' },
  { emoji: '↻', label: 'Rifai il mio sito attuale', fill: 'Ho già un sito ma è abbandonato: vorrei che ci pensasse qualcun altro.' },
];
---

<Base title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <!-- ============ hero: il primo messaggio ============ -->
  <section class="hero">
    <div class="hero__bg" aria-hidden="true">
      <span class="hero__float hero__float--a"></span>
      <span class="hero__float hero__float--b"></span>
      <span class="hero__float hero__float--c"></span>
      <span class="hero__float hero__float--d"></span>
    </div>

    <div class="container hero__inner" data-reveal-group>
      <p class="badge" data-reveal>{EARLY_ACCESS_LABEL}</p>
      <h1 class="display" data-reveal>Il sito della tua attività?<br />Dillo a Paco.</h1>
      <p class="lede" data-reveal>
        Racconta il tuo mestiere come lo racconteresti a un collaboratore: Paco crea il sito web,
        lo aggiorna quando gli scrivi e risponde ai tuoi clienti su WhatsApp.
      </p>

      <form class="prompt" action="/early-access" method="get" data-reveal>
        <label class="sr-only" for="hero-msg">Il tuo primo messaggio per Paco</label>
        <textarea
          id="hero-msg"
          name="msg"
          rows="3"
          maxlength="500"
          placeholder="Sono Lucia, ho un salone a Busto Arsizio…"
          data-typewriter></textarea>
        <div class="prompt__bar">
          <span class="prompt__hint mono" aria-hidden="true">scrivi come parli · invio = inizia</span>
          <button class="prompt__send" type="submit">
            Inizia
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path d="M4 12h15M13 5l7 7-7 7" />
            </svg>
          </button>
        </div>
      </form>

      <div class="prompt__chips" data-reveal>
        <span class="mono prompt__chips-label">o parti da un esempio:</span>
        {
          chips.map((c) => (
            <a
              class="prompt__chip"
              href={`/early-access?msg=${encodeURIComponent(c.fill)}`}
              data-fill={c.fill}
            >
              <span aria-hidden="true">{c.emoji}</span> {c.label}
            </a>
          ))
        }
      </div>

      <p class="hero__trust mono" data-reveal>
        0 pannelli · 0 password · risposte ai clienti incluse · un prodotto
        <a href={ALPACODE_URL} rel="noopener">Alpacode</a>
      </p>
    </div>
  </section>

  <Marquee />

  <!-- ============ prova tu: comando → sito ============ -->
  <CommandDemo />

  <!-- ============ come funziona ============ -->
  <section class="section" aria-labelledby="come-funziona-title">
    <div class="container howto">
      <div class="howto__steps">
        <SectionHead
          eyebrow="Come funziona"
          title="Tre passi. Nessuno davanti a un computer."
          lede="Il sito lo fa Paco: a te resta il mestiere tuo."
        />
        <div class="steps" data-reveal-group>
          {
            steps.map((s) => (
              <article class="steps__item" data-reveal>
                <p class="steps__n mono">{s.n}</p>
                <h3>{s.t}</h3>
                <p class="muted">{s.d}</p>
              </article>
            ))
          }
        </div>
        <p class="section__more" data-reveal>
          <a href="/come-funziona">Guarda tutto il percorso, con le conversazioni vere →</a>
        </p>
      </div>
      <div class="howto__demo" data-reveal>
        <ChatDemo demo="parrucchieri" />
      </div>
    </div>
  </section>

  <!-- ============ showcase ============ -->
  <SiteShowcase />

  <!-- ============ risponde ai clienti ============ -->
  <section class="section clients" aria-labelledby="clienti-title">
    <div class="container clients__grid">
      <div class="clients__demo" data-reveal>
        <ChatDemo demo="artigiani" />
      </div>
      <div class="clients__copy stack">
        <SectionHead
          eyebrow="Il tuo assistente"
          title="Ai tuoi clienti risponde Paco."
          lede="«Siete aperti domani?» «Quanto costa?» «C’è posto stasera?» Le domande di ogni giorno trovano risposta subito, a qualsiasi ora — tu intervieni solo quando serve davvero."
        />
        <ul class="clients__rules" data-reveal-group>
          <li data-reveal>
            <strong>Si presenta sempre come assistente.</strong> Nessuno crederà di parlare con te.
          </li>
          <li data-reveal>
            <strong>Risponde solo con le informazioni del tuo sito.</strong> Se non sa una cosa, lo
            dice — e la chiede a te. Non inventa, mai.
          </li>
          <li data-reveal>
            <strong>Ti passa la mano quando conta:</strong> richieste particolari, lamentele,
            trattative arrivano a te con un riepilogo ordinato.
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ============ funzionalità ============ -->
  <section class="section" aria-labelledby="funzioni-title">
    <div class="container">
      <SectionHead
        eyebrow="Cosa fa"
        title="Un collaboratore, non un altro programma."
        lede="Tutto quello che segue è compreso nel canone. Quello che ancora non c’è — prenotazioni con calendario, pagamenti — lo trovi scritto chiaro, al futuro, nelle FAQ."
      />
      <div class="features-grid" data-reveal-group>
        {
          features.map((f) => (
            <article class="features-grid__item" data-reveal>
              <h3>{f.t}</h3>
              <p class="muted">{f.d}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ voci e fondatori ============ -->
  <VoicesWall />

  <!-- ============ per chi ============ -->
  <section class="section section--tight" aria-labelledby="per-chi-title">
    <div class="container">
      <SectionHead eyebrow="Per chi" title="Fatto per chi ha le mani occupate." />
      <div class="verticals" data-reveal-group>
        {
          verticals.map((v) => (
            <a class="verticals__card" href={v.href} data-reveal>
              <h3>{v.label}</h3>
              <p class="muted">{v.quote}</p>
              <span class="mono verticals__arrow" aria-hidden="true">
                →
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ prezzi teaser ============ -->
  <section class="section" aria-labelledby="prezzi-title">
    <div class="container">
      <SectionHead
        eyebrow="Prezzi di lancio"
        title="Un canone chiaro. Nessun preventivo."
        lede="Tutto incluso: sito, aggiornamenti illimitati, risposte ai clienti. IVA esclusa, disdici quando vuoi."
      />
      <div data-reveal>
        <PricingCards compact />
      </div>
      <p class="section__more" data-reveal>
        <a href="/prezzi">Vedi cosa comprende ogni fascia →</a>
      </p>
    </div>
  </section>

  <!-- ============ manifesto ============ -->
  <section class="section manifesto-teaser">
    <div class="container manifesto-teaser__inner" data-reveal>
      <blockquote>
        <p class="display">«I siti non muoiono di brutto design. Muoiono di abbandono.»</p>
      </blockquote>
      <p><a href="/manifesto">Leggi il manifesto di Paco →</a></p>
    </div>
  </section>

  <CtaBand />

  <!-- CTA WhatsApp sempre raggiungibile anche da qui -->
  <div class="sr-only">
    <WhatsAppCta fallbackHref="/come-funziona" fallbackLabel={t('cta.comeFunziona')} />
  </div>
</Base>

<style>
  /* ============ hero ============ */
  .hero {
    position: relative;
    border-bottom: 1px solid var(--line);
    padding-block: calc(var(--section) * 1.05);
    overflow: hidden;
  }
  .hero__inner {
    position: relative;
    display: grid;
    justify-items: center;
    text-align: center;
    gap: var(--space-4);
    max-width: 52rem;
  }
  .hero__inner .lede {
    margin-inline: auto;
  }

  /* fumetti decorativi con parallax (CSS scroll-driven, zero JS) */
  .hero__float {
    position: absolute;
    background: var(--surface-2);
    border: 1px solid var(--line);
    opacity: 0.55;
  }
  .hero__float::after {
    content: '';
    position: absolute;
    bottom: -6px;
    inset-inline-start: -6px;
    width: 10px;
    height: 10px;
    background: inherit;
  }
  .hero__float--a {
    width: 90px;
    height: 46px;
    top: 12%;
    left: 6%;
  }
  .hero__float--b {
    width: 60px;
    height: 34px;
    top: 58%;
    left: 12%;
    border-color: var(--accent);
    opacity: 0.35;
  }
  .hero__float--c {
    width: 110px;
    height: 52px;
    top: 18%;
    right: 7%;
  }
  .hero__float--d {
    width: 70px;
    height: 38px;
    top: 64%;
    right: 13%;
    border-color: var(--accent);
    opacity: 0.35;
  }
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .hero__float {
        animation: hero-drift linear both;
        animation-timeline: scroll();
        animation-range: 0 120vh;
      }
      .hero__float--b,
      .hero__float--d {
        animation-name: hero-drift-fast;
      }
    }
  }
  @keyframes hero-drift {
    to {
      transform: translateY(-60px);
    }
  }
  @keyframes hero-drift-fast {
    to {
      transform: translateY(-140px);
    }
  }

  /* ---- composer ---- */
  .prompt {
    width: 100%;
    max-width: 40rem;
    background: var(--surface);
    border: 2px solid var(--line);
    box-shadow: var(--shadow);
    text-align: start;
    transition: border-color var(--t-fast) var(--ease);
  }
  .prompt:focus-within {
    border-color: var(--accent);
  }
  .prompt textarea {
    width: 100%;
    border: 0;
    background: transparent;
    padding: var(--space-3) var(--space-4);
    resize: none;
    font-size: 1.05rem;
    line-height: 1.5;
  }
  .prompt textarea:focus-visible {
    outline: none;
  }
  .prompt__bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-2) var(--space-2) var(--space-4);
    border-top: 1px solid var(--line);
  }
  .prompt__hint {
    font-size: var(--text-label);
    color: var(--ink-mute);
  }
  .prompt__send {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    background: var(--accent);
    color: var(--on-accent);
    border: 0;
    font-weight: 800;
    font-size: 1rem;
    padding: 0.65em 1.2em;
    cursor: pointer;
    transition:
      background var(--t-fast) var(--ease),
      transform var(--t-fast) var(--ease),
      box-shadow var(--t-fast) var(--ease);
  }
  .prompt__send:hover {
    background: var(--accent-press);
    transform: translate(-2px, -2px);
    box-shadow: 4px 4px 0 var(--line);
  }
  .prompt__send:active {
    transform: none;
    box-shadow: none;
  }

  .prompt__chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--space-2);
    max-width: 44rem;
  }
  .prompt__chips-label {
    font-size: var(--text-label);
    color: var(--ink-mute);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .prompt__chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    background: var(--surface);
    border: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.875rem;
    padding: 0.5em 0.9em;
    transition:
      border-color var(--t-fast) var(--ease),
      transform var(--t-fast) var(--ease),
      box-shadow var(--t-fast) var(--ease);
  }
  .prompt__chip:hover {
    border-color: var(--accent);
    color: var(--ink);
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0 var(--line);
  }
  .hero__trust {
    font-size: var(--text-label);
    color: var(--ink-mute);
    letter-spacing: 0.04em;
  }

  /* ============ come funziona ============ */
  .howto {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: var(--space-6);
    align-items: center;
  }
  .steps {
    display: grid;
    gap: var(--space-4);
  }
  .steps__item {
    border-inline-start: 2px solid var(--accent);
    padding-inline-start: var(--space-4);
    display: grid;
    gap: var(--space-2);
  }
  .steps__n {
    color: var(--accent-text);
    font-weight: 700;
  }
  .section__more {
    margin-block-start: var(--space-5);
    font-weight: 600;
  }
  .howto__demo {
    justify-self: end;
  }

  /* ============ clienti ============ */
  .clients {
    background: var(--surface);
    border-block: 1px solid var(--line);
  }
  .clients__grid {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: var(--space-6);
    align-items: center;
  }
  .clients__rules {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }
  .clients__rules li {
    border-inline-start: 3px solid var(--accent);
    padding-inline-start: var(--space-3);
    color: var(--ink-dim);
  }
  .clients__rules strong {
    color: var(--ink);
  }

  /* ============ funzionalità ============ */
  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
  }
  .features-grid__item h3 {
    display: inline-block;
    border-bottom: 2px solid var(--accent);
    padding-block-end: var(--space-2);
    margin-block-end: var(--space-2);
  }

  /* ============ per chi ============ */
  .verticals {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
  }
  .verticals__card {
    position: relative;
    display: grid;
    gap: var(--space-2);
    background: var(--surface);
    border: 1px solid var(--line);
    padding: var(--space-4);
    text-decoration: none;
    color: var(--ink);
    transition:
      transform var(--t-fast) var(--ease),
      box-shadow var(--t-fast) var(--ease),
      border-color var(--t-fast) var(--ease);
  }
  .verticals__card:hover {
    border-color: var(--accent);
    transform: translate(-2px, -2px);
    box-shadow: var(--shadow);
    color: var(--ink);
  }
  .verticals__arrow {
    position: absolute;
    top: var(--space-4);
    inset-inline-end: var(--space-4);
    color: var(--accent-text);
  }

  /* ============ manifesto teaser ============ */
  .manifesto-teaser__inner {
    max-width: 50rem;
    display: grid;
    gap: var(--space-4);
  }
  .manifesto-teaser blockquote {
    border-inline-start: 6px solid var(--accent);
    padding-inline-start: var(--space-4);
  }
  .manifesto-teaser blockquote p {
    font-size: clamp(1.4rem, 1rem + 2vw, 2.2rem);
  }

  @media (max-width: 56rem) {
    .howto,
    .clients__grid {
      grid-template-columns: 1fr;
    }
    .howto__demo,
    .clients__demo {
      justify-self: center;
    }
    .clients__demo {
      order: 2;
    }
    .features-grid,
    .verticals {
      grid-template-columns: 1fr;
    }
    .hero__float {
      display: none;
    }
  }
</style>

<script>
  // Typewriter sul placeholder + chip che riempiono il composer.
  // Tutto progressive enhancement: senza JS i chip sono link con ?msg=…
  // e il form fa una GET verso /early-access.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const area = document.querySelector<HTMLTextAreaElement>('[data-typewriter]');
  const form = area?.closest('form') ?? null;

  const EXAMPLES = [
    'Sono Lucia, ho un salone a Busto Arsizio…',
    'Ho una pizzeria a Quarto, il menù cambia sempre…',
    'Sono idraulico a Modena e perdo chiamate quando lavoro…',
    'Ho uno studio tecnico a Bari, vorrei richieste fatte bene…',
  ];

  if (area && !reduce) {
    let stopped = false;
    let example = 0;

    const type = async () => {
      while (!stopped) {
        const text = EXAMPLES[example % EXAMPLES.length] ?? '';
        for (let i = 1; i <= text.length && !stopped; i++) {
          area.placeholder = text.slice(0, i);
          await new Promise((r) => setTimeout(r, 34));
        }
        await new Promise((r) => setTimeout(r, 2200));
        example += 1;
      }
    };
    const stop = () => {
      stopped = true;
      area.placeholder = EXAMPLES[0] ?? '';
    };
    area.addEventListener('focus', stop, { once: true });
    area.addEventListener('input', stop, { once: true });
    void type();
  }

  if (area) {
    // Invio = submit (Shift+Invio va a capo)
    area.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' && !event.shiftKey) {
        event.preventDefault();
        form?.submit();
      }
    });
    // i chip riempiono il composer invece di navigare
    document.querySelectorAll<HTMLAnchorElement>('.prompt__chip[data-fill]').forEach((chip) => {
      chip.addEventListener('click', (event) => {
        event.preventDefault();
        area.value = chip.dataset.fill ?? '';
        area.focus();
        area.dispatchEvent(new Event('input'));
      });
    });
  }
</script>
