---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const fmt = new Intl.DateTimeFormat('it-IT', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Base
  title="Blog"
  description="Siti vivi, piccole attività, WhatsApp: il blog di Paco. Guide concrete e ragionamenti onesti, senza gergo tecnico."
>
  <section class="section">
    <div class="container stack pagehead">
      <p class="eyebrow">Blog</p>
      <h1 class="display">Cose utili, scritte come parliamo.</h1>
      <p class="lede">
        Guide concrete per chi ha un’attività e poco tempo, più qualche ragionamento su come
        costruiamo Paco. Anche via <a href="/rss.xml">RSS</a>.
      </p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      {
        posts.length === 0 ? (
          <p class="lede">
            I primi articoli arrivano col lancio. Nel frattempo c’è il
            <a href="/manifesto">manifesto</a>.
          </p>
        ) : (
          <ul class="posts">
            {posts.map((post) => (
              <li class="posts__item">
                <article>
                  <p class="mono posts__date">
                    <time datetime={post.data.pubDate.toISOString()}>
                      {fmt.format(post.data.pubDate)}
                    </time>
                    {post.data.tags.length > 0 && <span> · {post.data.tags.join(' · ')}</span>}
                  </p>
                  <h2>
                    <a href={`/blog/${post.id}`}>{post.data.title}</a>
                  </h2>
                  <p class="muted">{post.data.description}</p>
                </article>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .pagehead {
    max-width: 56rem;
  }
  .posts {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-4);
    max-width: 46rem;
  }
  .posts__item article {
    border: 1px solid var(--line);
    background: var(--surface);
    padding: var(--space-4);
    display: grid;
    gap: var(--space-2);
  }
  .posts__date {
    font-size: var(--text-label);
    color: var(--ink-mute);
  }
  .posts__item h2 {
    font-size: 1.3rem;
  }
  .posts__item h2 a {
    color: var(--ink);
    text-decoration: none;
  }
  .posts__item h2 a:hover {
    color: var(--accent-text);
  }
</style>
