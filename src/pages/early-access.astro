---
import Base from '../layouts/Base.astro';
import WhatsAppCta from '../components/WhatsAppCta.astro';
import { FOUNDERS_SEATS, EARLY_ACCESS_LABEL } from '../config';

const perks = [
  {
    t: 'Tariffa fondatori bloccata',
    d: `Assistente a 39 €/mese invece di 59, finché resti. Riservata ai primi ${FOUNDERS_SEATS} attivati.`,
  },
  {
    t: 'Prima degli altri',
    d: 'Attivi Paco quando si apre il tuo posto, con l’aiuto diretto del team che lo costruisce.',
  },
  {
    t: 'Voce in capitolo',
    d: 'Il tuo feedback decide le priorità: costruiamo per il tuo mestiere, non per le slide.',
  },
];

const next = [
  { n: '01', d: 'Compili il modulo qui sotto: mezzo minuto, niente pagamento.' },
  { n: '02', d: 'Ti scriviamo su WhatsApp per conoscerti: che attività hai, cosa ti serve.' },
  { n: '03', d: 'Quando si apre il tuo posto, decidi con calma se attivare. Nessun obbligo.' },
];
---

<Base
  title="Early access"
  description="Entra nella lista d’attesa di Paco: 50 posti fondatori con tariffa bloccata a 39 €/mese. Iscrizione gratuita, niente pagamento, ti contattiamo su WhatsApp quando si apre il tuo posto."
>
  <section class="section pagehero">
    <div class="container stack">
      <p class="badge">{EARLY_ACCESS_LABEL}</p>
      <h1 class="display">Il tuo sito, prima degli altri.</h1>
      <p class="lede">
        Paco parte in early access a fine 2026, con {FOUNDERS_SEATS} posti fondatori. Iscriverti
        alla lista è gratis e non ti impegna: quando si apre il tuo posto, ti scriviamo su
        WhatsApp e decidi.
      </p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container ea-grid">
      <div class="ea-copy stack">
        <div class="perks">
          {
            perks.map((p) => (
              <article class="perks__item">
                <h2>{p.t}</h2>
                <p class="muted">{p.d}</p>
              </article>
            ))
          }
        </div>

        <div class="next">
          <h2 class="eyebrow">Cosa succede dopo</h2>
          <ol class="next__list">
            {
              next.map((s) => (
                <li>
                  <span class="mono next__n">{s.n}</span>
                  <span>{s.d}</span>
                </li>
              ))
            }
          </ol>
        </div>

        <div class="ea-wa">
          <p class="muted">Preferisci parlare invece di compilare?</p>
          <WhatsAppCta />
        </div>
      </div>

      <form
        id="form"
        class="ea-form"
        method="post"
        action="/api/waitlist"
        novalidate
      >
        <h2 class="display ea-form__title">Mettiti in lista</h2>

        <p class="ea-form__status" data-status role="status" aria-live="polite" hidden></p>

        <div class="ea-form__field">
          <label for="nome">Nome e cognome</label>
          <input
            type="text"
            id="nome"
            name="nome"
            required
            maxlength="120"
            autocomplete="name"
            placeholder="Es. Lucia Colombo"
          />
        </div>

        <div class="ea-form__field">
          <label for="attivita">La tua attività</label>
          <input
            type="text"
            id="attivita"
            name="attivita"
            required
            maxlength="160"
            autocomplete="organization"
            placeholder="Es. Lucia Hair Style, Busto Arsizio"
          />
        </div>

        <div class="ea-form__field">
          <label for="whatsapp">Numero WhatsApp</label>
          <input
            type="tel"
            id="whatsapp"
            name="whatsapp"
            required
            inputmode="tel"
            autocomplete="tel"
            pattern="[0-9+ ]{8,20}"
            placeholder="Es. +39 340 123 4567"
          />
          <p class="ea-form__hint">Ti scriviamo qui, solo per l’early access. Niente spam.</p>
        </div>

        <div class="ea-form__field">
          <label for="messaggio">Il tuo primo messaggio per Paco <span class="ea-form__optional">(facoltativo)</span></label>
          <textarea
            id="messaggio"
            name="messaggio"
            rows="3"
            maxlength="600"
            placeholder="Es. Ho una pizzeria a Quarto, il menù cambia spesso e il sito è fermo dal 2023…"
          ></textarea>
          <p class="ea-form__hint">Raccontaci l’attività come la racconteresti a lui: ci aiuta a prepararti il posto.</p>
        </div>

        <!-- honeypot: gli umani non lo vedono e non lo compilano -->
        <div class="ea-form__hp" aria-hidden="true">
          <label for="website">Sito web</label>
          <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
        </div>
        <input type="hidden" name="t" value="" data-timestamp />

        <div class="ea-form__consent">
          <input type="checkbox" id="consenso" name="consenso" required />
          <label for="consenso">
            Ho letto la <a href="/privacy">privacy policy</a> e accetto che questi dati vengano
            usati per gestire la lista d’attesa.
          </label>
        </div>

        <button class="btn btn--primary ea-form__submit" type="submit">
          Prenota il posto fondatore
        </button>
        <p class="ea-form__hint mono">Gratis · senza impegno · disdici l’iscrizione quando vuoi</p>
      </form>
    </div>
  </section>
</Base>

<style>
  .pagehero {
    border-bottom: 1px solid var(--line);
  }
  .pagehero .container {
    max-width: 56rem;
  }
  .ea-grid {
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    gap: var(--space-6);
    align-items: start;
  }
  .perks {
    display: grid;
    gap: var(--space-4);
  }
  .perks__item h2 {
    font-size: 1.15rem;
    font-weight: 800;
    border-inline-start: 3px solid var(--accent);
    padding-inline-start: var(--space-3);
    margin-block-end: var(--space-2);
  }
  .perks__item p {
    padding-inline-start: calc(var(--space-3) + 3px);
  }
  .next {
    margin-block-start: var(--space-5);
  }
  .next__list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-3);
    margin-block-start: var(--space-3);
  }
  .next__list li {
    display: flex;
    gap: var(--space-3);
    align-items: baseline;
  }
  .next__n {
    color: var(--accent-text);
    font-weight: 700;
    flex-shrink: 0;
  }
  .ea-wa {
    margin-block-start: var(--space-5);
    display: grid;
    gap: var(--space-2);
    justify-items: start;
  }

  .ea-form {
    background: var(--surface);
    border: 2px solid var(--line);
    box-shadow: var(--shadow);
    padding: var(--space-5);
    display: grid;
    gap: var(--space-4);
  }
  .ea-form__title {
    font-size: 1.6rem;
  }
  .ea-form__field {
    display: grid;
    gap: var(--space-2);
  }
  .ea-form__field label {
    font-weight: 800;
    font-size: 0.95rem;
  }
  .ea-form__optional {
    font-weight: 400;
    color: var(--ink-mute);
    font-size: var(--text-label);
  }
  .ea-form textarea,
  .ea-form input[type='text'],
  .ea-form input[type='tel'] {
    background: var(--bg);
    border: 1px solid var(--line);
    padding: 0.8em 1em;
    width: 100%;
  }
  .ea-form input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 0;
    border-color: var(--accent);
  }
  .ea-form__hint {
    font-size: var(--text-label);
    color: var(--ink-mute);
  }
  .ea-form__hp {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  .ea-form__consent {
    display: flex;
    gap: var(--space-2);
    align-items: flex-start;
    font-size: var(--text-small);
    color: var(--ink-dim);
  }
  .ea-form__consent input {
    margin-block-start: 0.3em;
    accent-color: var(--accent);
    width: 1.05rem;
    height: 1.05rem;
    flex-shrink: 0;
  }
  .ea-form__submit {
    justify-content: center;
  }
  .ea-form__status {
    border: 1px solid var(--accent);
    padding: var(--space-3);
    font-weight: 600;
  }
  .ea-form__status[data-kind='error'] {
    border-color: #d9634c;
  }
  .ea-form__status[hidden] {
    display: none;
  }
  @media (max-width: 56rem) {
    .ea-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('.ea-form');
  const status = document.querySelector<HTMLElement>('[data-status]');
  const stamp = document.querySelector<HTMLInputElement>('[data-timestamp]');

  // il timestamp serve al time-trap dell'endpoint (solo con JS attivo)
  if (stamp) stamp.value = String(Date.now());

  // errore riportato dal redirect no-JS: mostrato se presente in query
  const params = new URLSearchParams(window.location.search);
  const urlError = params.get('errore');

  // il prompt scritto nella hero della home arriva come ?msg=…
  const heroMsg = params.get('msg');
  const messageArea = document.querySelector<HTMLTextAreaElement>('#messaggio');
  if (heroMsg && messageArea && messageArea.value === '') {
    messageArea.value = heroMsg.slice(0, 600);
  }

  function show(kind: 'ok' | 'error', message: string): void {
    if (!status) return;
    status.hidden = false;
    status.dataset.kind = kind;
    status.textContent = message;
  }

  if (urlError && status) {
    show('error', decodeURIComponent(urlError));
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (!form.reportValidity()) return;
    if (button) {
      button.disabled = true;
      button.textContent = 'Invio…';
    }
    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      const data = (await response.json()) as { ok: boolean; error?: string };
      if (data.ok) {
        window.location.assign('/grazie');
        return;
      }
      show('error', data.error ?? 'Qualcosa non ha funzionato: riprova tra un momento.');
    } catch {
      show('error', 'Connessione ballerina: riprova tra un momento.');
    } finally {
      if (button) {
        button.disabled = false;
        button.textContent = 'Prenota il posto fondatore';
      }
    }
  });
</script>
