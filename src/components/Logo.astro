---
interface Props {
  /** dimensione del simbolo in px */
  size?: number;
  withWordmark?: boolean;
}
const { size = 28, withWordmark = true } = Astro.props;
---

<span class="logo" translate="no">
  <svg
    class="logo__mark"
    width={size}
    height={size}
    viewBox="0 0 64 64"
    role="img"
    aria-label="Paco"
  >
    <rect x="4" y="4" width="56" height="46" fill="#25D366"></rect>
    <rect x="10" y="50" width="12" height="10" fill="#25D366"></rect>
    <path
      d="M26 16h12c6 0 10 4 10 10s-4 10-10 10h-6v6h-6V16Zm6 6v8h6c2.6 0 4-1.6 4-4s-1.4-4-4-4h-6Z"
      fill="#06130B"></path>
  </svg>
  {withWordmark && <span class="logo__word">paco</span>}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .logo__word {
    font-family: var(--font-display);
    font-size: 1.35rem;
    letter-spacing: -0.01em;
    color: var(--ink);
    line-height: 1;
  }
</style>
