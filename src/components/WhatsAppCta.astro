---
import { WHATSAPP_NUMBER, waHref } from '../config';
import { t } from '../i18n/ui';

/**
 * CTA secondaria: link WhatsApp diretto quando PUBLIC_WHATSAPP_NUMBER è
 * configurato; altrimenti il link di riserva indicato dalla pagina
 * (mai un numero finto).
 */
interface Props {
  label?: string;
  message?: string;
  fallbackHref?: string;
  fallbackLabel?: string;
  class?: string;
}

const {
  label = t('cta.whatsapp'),
  message,
  fallbackHref,
  fallbackLabel,
  class: className = 'btn btn--ghost',
} = Astro.props;

const hasNumber = WHATSAPP_NUMBER.length > 0;
---

{
  hasNumber ? (
    <a class={className} href={waHref(message)} rel="noopener">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 2a10 10 0 0 0-8.7 14.9L2 22l5.3-1.3A10 10 0 1 0 12 2Zm0 2a8 8 0 1 1-4.2 14.8l-.3-.2-3 .7.8-2.9-.2-.3A8 8 0 0 1 12 4Zm-3.1 4c-.2 0-.5 0-.7.3-.2.3-.9.9-.9 2.1s.9 2.4 1 2.6c.2.2 1.8 2.8 4.4 3.8 2.2.9 2.6.7 3.1.7.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2l-.5-.3-1.8-.9c-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.5 6.5 0 0 1-3.2-2.8c-.1-.2 0-.4.1-.5l.6-.7c.2-.2.2-.4.1-.6l-.8-2c-.2-.4-.4-.4-.6-.4h-.5Z" />
      </svg>
      {label}
    </a>
  ) : fallbackHref ? (
    <a class={className} href={fallbackHref}>
      {fallbackLabel ?? label}
    </a>
  ) : null
}
