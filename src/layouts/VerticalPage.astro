---
import Base from './Base.astro';
import ChatDemo from '../components/ChatDemo.astro';
import SectionHead from '../components/SectionHead.astro';
import Faq, { type FaqItem } from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import WhatsAppCta from '../components/WhatsAppCta.astro';
import { t } from '../i18n/ui';
import type { DemoId } from '../data/demos';

/**
 * Layout condiviso delle landing di settore (le pagine SEO principali).
 * La struttura è identica, la copy arriva dalla pagina.
 */
interface Props {
  metaTitle: string;
  metaDescription: string;
  eyebrow: string;
  h1: string;
  lede: string;
  pains: { t: string; d: string }[];
  painsTitle: string;
  demoId: DemoId;
  demoTitle: string;
  demoLede: string;
  demoNote?: string;
  features: { t: string; d: string }[];
  faqs: FaqItem[];
}

const {
  metaTitle,
  metaDescription,
  eyebrow,
  h1,
  lede,
  pains,
  painsTitle,
  demoId,
  demoTitle,
  demoLede,
  demoNote,
  features,
  faqs,
} = Astro.props;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') },
  })),
};
---

<Base title={metaTitle} description={metaDescription} schema={faqSchema}>
  <section class="section vhero">
    <div class="container">
      <p class="eyebrow"><a href="/per-chi">Per chi</a> · {eyebrow}</p>
      <h1 class="display">{h1}</h1>
      <p class="lede">{lede}</p>
      <div class="vhero__actions">
        <a class="btn btn--primary" href="/early-access">{t('cta.earlyAccess')}</a>
        <WhatsAppCta fallbackHref="/come-funziona" fallbackLabel={t('cta.comeFunziona')} />
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <SectionHead title={painsTitle} />
      <div class="pains">
        {
          pains.map((p) => (
            <article class="card">
              <h3>{p.t}</h3>
              <p class="muted">{p.d}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container vdemo">
      <div class="vdemo__copy stack">
        <SectionHead title={demoTitle} lede={demoLede} />
        {demoNote && <p class="vdemo__note mono">{demoNote}</p>}
      </div>
      <ChatDemo demo={demoId} />
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <SectionHead title="Cosa fa Paco per te" />
      <div class="features">
        {
          features.map((f) => (
            <article class="features__item">
              <h3>{f.t}</h3>
              <p class="muted">{f.d}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHead title="Domande di chi fa il tuo mestiere" />
      <Faq items={faqs} />
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .vhero {
    border-bottom: 1px solid var(--line);
  }
  .vhero .container {
    display: grid;
    gap: var(--space-4);
    max-width: 56rem;
  }
  .vhero__actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
  .pains {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: var(--space-3);
  }
  .pains h3 {
    margin-block-end: var(--space-2);
  }
  .vdemo {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: var(--space-6);
    align-items: start;
  }
  .vdemo__note {
    font-size: var(--text-small);
    color: var(--ink-mute);
    border-inline-start: 3px solid var(--accent);
    padding-inline-start: var(--space-3);
  }
  .features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--space-4) var(--space-5);
  }
  .features h3 {
    margin-block-end: var(--space-2);
    padding-block-end: var(--space-2);
    border-bottom: 2px solid var(--accent);
    display: inline-block;
  }
  @media (max-width: 56rem) {
    .vdemo {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
  }
</style>
