# URL pubblico del sito: canonical, sitemap, card OG.
# Da aggiornare quando il dominio definitivo del lancio è registrato.
SITE=https://paco.alpacode.it

# Numero WhatsApp pubblico (solo cifre con prefisso internazionale,
# es. 393401234567). Finché è vuoto, le CTA WhatsApp mostrano il link
# di riserva (early access / come funziona) — mai un numero finto.
PUBLIC_WHATSAPP_NUMBER=

# Notifiche della lista d'attesa via Resend (https://resend.com).
# Senza chiave, il form funziona comunque: le iscrizioni finiscono nei
# log del server.
RESEND_API_KEY=
WAITLIST_TO=founders@alpacode.it
WAITLIST_FROM=Paco <onboarding@resend.dev>
